# SmartLock backend API base URL
#
# Local dev (docker-compose):
#   PUBLIC_SMARTLOCK_API_URL=http://localhost:8000
# Production:
#   PUBLIC_SMARTLOCK_API_URL=https://api.smartlock.devinci-fablab.fr
PUBLIC_SMARTLOCK_API_URL=http://localhost:8000

# Keycloak realm
#
# Realms available on https://auth.devinci-fablab.fr :
#   - master : Keycloak admin (do NOT use as application realm)
#   - dev    : test users + test app
#   - prod   : production
#
# Local dev against docker-compose Keycloak:
#   KEYCLOAK_ISSUER=http://localhost:8080/realms/dev
# Dev against the shared dev realm:
#   KEYCLOAK_ISSUER=https://auth.devinci-fablab.fr/realms/dev
# Production:
#   KEYCLOAK_ISSUER=https://auth.devinci-fablab.fr/realms/prod
KEYCLOAK_ISSUER=https://auth.devinci-fablab.fr/realms/dev
KEYCLOAK_CLIENT_ID=smartlock-dashboard
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:5173/login/callback
KEYCLOAK_POST_LOGOUT_URI=http://localhost:5173

# Session cookie secret (32+ random bytes — generate via `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-real-secret-32-bytes-minimum
